   ],
   "source": [
    "cars[\"horsepower\"] = cars[\"horsepower\"].replace(\"?\", pd.NA)\n",
    "cars[\"horsepower\"] = pd.to_numeric(cars[\"horsepower\"])\n",
    "\n",
    "cars[\"horsepower\"].isna().sum()\n"
   ]
  },
  {
   "cell_type": "markdown",
